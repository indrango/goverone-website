---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import { companies } from '../../content/landing-page';
---
<MarketingSection id="companies" spacing="default">
  <Container variant="content">
    <div class="section-split section-split--reverse">
      <ProductFrame title="Shared implementation workspace" caption="ISO PIC, approver, management, dan konsultan melihat konteks yang sama">
        <div class="company-collaboration">
          <div class="company-collaboration__members">
            <div class="member-pill"><strong>ISO PIC</strong><span>Project owner</span></div>
            <div class="member-pill"><strong>Management</strong><span>Document approver</span></div>
            <div class="member-pill"><strong>Consultant</strong><span>Implementation guide</span></div>
          </div>
          <div class="company-collaboration__timeline">
            <div class="timeline-row"><span>Access control policy</span><strong>Approved</strong></div>
            <div class="timeline-row"><span>User provisioning SOP</span><strong>Needs revision</strong></div>
            <div class="timeline-row"><span>Evidence package</span><strong>Uploaded</strong></div>
          </div>
        </div>
      </ProductFrame>
      <div>
        <SectionHeading eyebrow={companies.eyebrow} title={companies.title} body={companies.body} size="lg" />
        <div class="benefit-list">
          {companies.benefits.map((benefit) => (
            <article class="benefit-item">
              <h3>{benefit.title}</h3>
              <p>{benefit.body}</p>
            </article>
          ))}
        </div>
        <div class="section-actions reveal-item">
          <Button href={companies.cta.href} variant="outline" size="lg">{companies.cta.label}</Button>
        </div>
      </div>
    </div>
  </Container>
</MarketingSection>
