---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { consultants, companies } from '../../content/landing-page';
---
<MarketingSection id="consultants" surface="muted" spacing="default">
  <Container variant="content">
    <div class="audience-value-section">
      <SectionHeading title={consultants.title} body={consultants.body} size="lg" />

      <div class="audience-value-grid">
        <article class="audience-value-card audience-value-card--consultant reveal-panel">
          <div class="audience-value-card__header">
            <span>{consultants.audienceLabel}</span>
            <h3>{consultants.audienceTitle}</h3>
            <p>{consultants.audienceBody}</p>
          </div>
          <ul class="audience-value-card__list">
            {consultants.benefits.map((benefit) => (
              <li>
                <strong>{benefit.title}</strong>
                <span>{benefit.body}</span>
              </li>
            ))}
          </ul>
        </article>

        <article class="audience-value-card audience-value-card--company reveal-panel">
          <div class="audience-value-card__header">
            <span>{companies.audienceLabel}</span>
            <h3>{companies.audienceTitle}</h3>
            <p>{companies.audienceBody}</p>
          </div>
          <ul class="audience-value-card__list">
            {companies.benefits.map((benefit) => (
              <li>
                <strong>{benefit.title}</strong>
                <span>{benefit.body}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <div class="section-actions reveal-item">
        <Button href={consultants.cta.href} variant="primary" size="lg">{consultants.cta.label}</Button>
      </div>
    </div>
  </Container>
</MarketingSection>
