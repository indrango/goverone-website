---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { finalCta } from '../../content/landing-page';
---
<MarketingSection id="final-cta" surface="dark" spacing="featured">
  <Container variant="content">
    <div class="final-cta-grid reveal-section">
      <div class="final-cta-copy">
        <SectionHeading title={finalCta.title} body={finalCta.body} size="lg" />
        <p class="final-cta__microcopy reveal-item">{finalCta.microcopy}</p>
      </div>
      <form
        class="lead-form-card reveal-panel"
        id="demo-form"
        action="https://formspree.io/f/mwvganeq"
        method="POST"
        aria-label="Form minat demo GoverOne"
      >
        <div class="lead-form-card__header">
          <h3>Ceritakan kebutuhan implementasi Anda</h3>
        </div>
        <div class="lead-form-card__grid">
          <label>
            <span>Nama</span>
            <input type="text" name="name" autocomplete="name" placeholder="Nama lengkap" required />
          </label>
          <label>
            <span>Email kerja</span>
            <input type="email" name="email" autocomplete="email" placeholder="nama@perusahaan.com" required />
          </label>
          <label>
            <span>Tipe organisasi</span>
            <select name="organization-type">
              <option>Konsultan</option>
              <option>Perusahaan</option>
            </select>
          </label>
          <label>
            <span>Jumlah proyek atau entitas aktif</span>
            <input type="text" name="active-projects" placeholder="Contoh: 3 proyek" />
          </label>
          <label class="lead-form-card__full">
            <span>Apakah sedang menjalankan ISO 27001?</span>
            <select name="iso-status">
              <option>Ya, sedang berjalan</option>
              <option>Belum, sedang merencanakan</option>
            </select>
          </label>
          <label class="lead-form-card__full">
            <span>Catatan kebutuhan</span>
            <textarea name="notes" rows="3" placeholder="Jelaskan workflow atau kebutuhan tim Anda"></textarea>
          </label>
          <label class="lead-form-card__full">
            <span>Jadwal demo yang diinginkan</span>
            <input type="text" name="schedule" placeholder="Hari dan waktu yang nyaman" />
          </label>
        </div>
        <div
          id="form-feedback"
          class="lead-form-card__feedback"
          role="status"
          aria-live="polite"
          hidden
        ></div>
        <button class="lead-form-card__submit" type="submit">
          <span class="lead-form-card__submit-label">{finalCta.submitLabel}</span>
          <span class="lead-form-card__submit-spinner" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="spinner">
              <path d="M21 12a9 9 0 1 1-6.219-8.56" />
            </svg>
          </span>
        </button>
      </form>
    </div>
  </Container>
</MarketingSection>

<script>
  const form = document.getElementById('demo-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement;
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const submitLabel = submitBtn.querySelector('.lead-form-card__submit-label') as HTMLSpanElement;
  const submitSpinner = submitBtn.querySelector('.lead-form-card__submit-spinner') as HTMLSpanElement;

  const FORMSPREE_URL = 'https://formspree.io/f/mwvganeq';

  function showFeedback(message: string, type: 'success' | 'error') {
    feedback.textContent = message;
    feedback.className = `lead-form-card__feedback lead-form-card__feedback--${type}`;
    feedback.hidden = false;
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitLabel.hidden = loading;
    submitSpinner.hidden = !loading;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    feedback.hidden = true;

    const formData = new FormData(form);

    // Extra validation beyond HTML5
    const email = (formData.get('email') as string).trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showFeedback('Mohon isi email kerja yang valid.', 'error');
      return;
    }

    const name = (formData.get('name') as string).trim();
    if (!name) {
      showFeedback('Mohon isi nama lengkap.', 'error');
      return;
    }

    setLoading(true);

    try {
      const response = await fetch(FORMSPREE_URL, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        window.posthog?.capture('demo_request_submitted', {
          organization_type: formData.get('organization-type'),
          iso_status: formData.get('iso-status'),
        });
        showFeedback('Terima kasih! Kami akan menghubungi Anda untuk menjadwalkan demo.', 'success');
        form.reset();
      } else {
        const data = await response.json().catch(() => ({}));
        const message = (data as any).error || 'Gagal mengirim. Silakan coba lagi.';
        showFeedback(message, 'error');
      }
    } catch {
      showFeedback('Gagal terhubung. Silakan coba lagi.', 'error');
    } finally {
      setLoading(false);
    }
  });
</script>

<style>
  .lead-form-card__feedback {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
  }
  .lead-form-card__feedback--success {
    background: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }
  .lead-form-card__feedback--error {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .lead-form-card__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }
  .lead-form-card__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .spinner {
    animation: spin 0.75s linear infinite;
  }
</style>
