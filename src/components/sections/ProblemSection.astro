---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import { problemSection } from '../../content/landing-page';
---
<MarketingSection id="problem" surface="muted" spacing="default">
  <Container variant="content">
    <div class="section-split section-split--problem reveal-section">
      <div>
        <SectionHeading title={problemSection.title} body={problemSection.paragraphs[0]} size="lg" />
        <p class="section-supporting-copy reveal-item">{problemSection.paragraphs[1]}</p>
      </div>
      <ProductFrame title="Traceability terputus" caption="Masalah muncul ketika alur implementasi tidak punya konteks bersama.">
        <div class="trace-breakdown" aria-label="Alur traceability implementasi yang terputus">
          <div class="trace-breakdown__chain">
            {problemSection.diagram.map((item, index) => (
              <>
                <span class={`trace-breakdown__node ${index === problemSection.diagram.length - 1 ? 'trace-breakdown__node--orphan' : ''}`}>{item}</span>
                {index < problemSection.diagram.length - 1 && <span class={`trace-breakdown__connector ${index === 1 || index === 3 ? 'trace-breakdown__connector--broken' : ''}`} aria-hidden="true"></span>}
              </>
            ))}
          </div>
          <div class="trace-breakdown__impact">
            <strong>Manual reconciliation</strong>
            <span>Status lambat, approval kabur, evidence sulit dibaca.</span>
          </div>
        </div>
      </ProductFrame>
    </div>
    <div class="problem-card-grid problem-signal-grid reveal-section">
      {problemSection.cards.map((card, index) => (
        <article class="info-card problem-signal-card" style={`--reveal-delay: ${210 + index * 70}ms`}>
          <div class={`problem-signal-card__visual problem-signal-card__visual--${card.visual}`} aria-hidden="true">
            {card.visual === 'scattered-context' && (
              <div class="problem-visual problem-visual--scattered">
                <span class="problem-signal-chip problem-signal-chip--muted">Decision</span>
                <span class="problem-signal-chip">Revision</span>
                <span class="problem-signal-chip problem-signal-chip--muted">Chat</span>
                <span class="problem-signal-chip problem-signal-chip--orphan">File</span>
              </div>
            )}
            {card.visual === 'ambiguous-approval' && (
              <div class="problem-visual problem-visual--approval">
                <span class="status-chip status-chip--muted">Draft</span>
                <span class="status-chip status-chip--warning">Review</span>
                <span class="status-chip status-chip--success">Approved</span>
                <span class="status-chip status-chip--info">Revised</span>
              </div>
            )}
            {card.visual === 'unlinked-evidence' && (
              <div class="problem-visual problem-visual--evidence">
                <div class="problem-signal-file">
                  <span></span>
                  <strong>File.pdf</strong>
                  <small>Uploaded</small>
                </div>
                <span class="problem-signal-line problem-signal-line--broken"></span>
                <div class="problem-signal-control">
                  <small>Control</small>
                  <strong>A.5.15</strong>
                  <span>Unlinked</span>
                </div>
              </div>
            )}
            {card.visual === 'inconsistent-delivery' && (
              <div class="problem-visual problem-visual--delivery">
                <div class="problem-signal-client-row"><strong>A</strong><span>Risk</span><span>Control</span><span>Evidence</span></div>
                <div class="problem-signal-client-row"><strong>B</strong><span>Folder</span><span>Email</span></div>
                <div class="problem-signal-client-row"><strong>C</strong><span>Sheet</span><span>Chat</span><span>File</span></div>
              </div>
            )}
          </div>
          <div class="problem-signal-card__copy">
            {card.label && <span class="problem-signal-card__label">{card.label}</span>}
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </Container>
</MarketingSection>
