---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import { problemSection } from '../../content/landing-page';
---
<MarketingSection id="problem" surface="muted" spacing="default">
  <Container variant="content">
    <div class="section-split section-split--problem reveal-section">
      <div>
        <SectionHeading title={problemSection.title} body={problemSection.paragraphs[0]} size="lg" />
        <p class="section-supporting-copy reveal-item">{problemSection.paragraphs[1]}</p>
      </div>
      <ProductFrame title="Traceability terputus" caption="Masalah muncul ketika alur implementasi tidak punya konteks bersama.">
        <div class="trace-breakdown" aria-label="Alur traceability implementasi yang terputus">
          <div class="trace-breakdown__chain">
            {problemSection.diagram.map((item, index) => (
              <>
                <span class={`trace-breakdown__node ${index === problemSection.diagram.length - 1 ? 'trace-breakdown__node--orphan' : ''}`}>{item}</span>
                {index < problemSection.diagram.length - 1 && <span class={`trace-breakdown__connector ${index === 1 || index === 3 ? 'trace-breakdown__connector--broken' : ''}`} aria-hidden="true"></span>}
              </>
            ))}
          </div>
          <div class="trace-breakdown__impact">
            <strong>Manual reconciliation</strong>
            <span>Status lambat, approval kabur, evidence sulit dibaca.</span>
          </div>
        </div>
      </ProductFrame>
    </div>
    <div class="problem-card-grid reveal-section">
      {problemSection.cards.map((card) => (
        <article class="info-card info-card--problem">
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </Container>
</MarketingSection>
