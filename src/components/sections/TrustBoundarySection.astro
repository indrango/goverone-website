---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { trustBoundary } from '../../content/landing-page';
---
<MarketingSection id="trust-boundary" surface="muted" spacing="default">
  <Container variant="content">
    <div class="section-split">
      <div>
        <SectionHeading title={trustBoundary.title} body={trustBoundary.body} size="lg" />
        <ul class="boundary-list">
          {trustBoundary.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="trust-panel">
        <h3>Batas peran tetap jelas</h3>
        <div class="trust-panel__stack">
          <div class="trust-panel__item"><span>Konsultan</span><strong>Memberikan arahan profesional</strong></div>
          <div class="trust-panel__item"><span>Perusahaan</span><strong>Memiliki dan menjalankan ISMS</strong></div>
          <div class="trust-panel__item"><span>Auditor / certification body</span><strong>Memberikan penilaian independen</strong></div>
        </div>
        <p>{trustBoundary.supporting}</p>
      </div>
    </div>
  </Container>
</MarketingSection>
