---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { howItWorks } from '../../content/landing-page';
---
<MarketingSection id="how-it-works" surface="brand-subtle" spacing="default" className="marketing-section--runway-sequence">
  <div class="runway-sequence" data-runway-sequence>
    <Container variant="content">
      <div class="runway-sequence__sticky">
        <SectionHeading title={howItWorks.title} align="center" width="narrow" size="lg" />
        <div class="implementation-runway reveal-section" aria-label="Alur kerja implementasi GoverOne">
          {howItWorks.steps.map((step, index) => (
            <article class={`implementation-runway__step ${index === 0 ? 'implementation-runway__step--visible implementation-runway__step--active' : ''}`} data-runway-step={index}>
              <div class="implementation-runway__marker">0{index + 1}</div>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="section-actions section-actions--center reveal-item">
          <Button href={howItWorks.cta.href} variant="outline" size="lg">{howItWorks.cta.label}</Button>
        </div>
      </div>
    </Container>
    <div class="runway-sequence__markers" aria-hidden="true">
      {howItWorks.steps.map((_, index) => <span data-runway-marker={index}></span>)}
    </div>
  </div>
</MarketingSection>

<script>
  const setupRunwaySequence = () => {
    const section = document.querySelector('[data-runway-sequence]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    if (!section) return;

    const steps = Array.from(section.querySelectorAll('[data-runway-step]'));
    if (!steps.length) return;

    const setActiveStep = (activeIndex) => {
      steps.forEach((step, index) => {
        step.classList.toggle('implementation-runway__step--visible', !isDesktop || reduceMotion || index <= activeIndex);
        step.classList.toggle('implementation-runway__step--active', isDesktop && !reduceMotion && index === activeIndex);
      });
    };

    if (!isDesktop || reduceMotion) {
      setActiveStep(steps.length - 1);
      return;
    }

    let ticking = false;
    const update = () => {
      const rect = section.getBoundingClientRect();
      const viewportPoint = window.innerHeight * 0.58;
      const progressStart = viewportPoint;
      const progressEnd = -rect.height * 0.2;
      const rawProgress = Math.min(Math.max((progressStart - rect.top) / (progressStart - progressEnd), 0), 1);
      const activeIndex = Math.min(Math.round(rawProgress * (steps.length - 1)), steps.length - 1);
      setActiveStep(activeIndex);
      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  };

  setupRunwaySequence();
  document.addEventListener('astro:page-load', setupRunwaySequence);
</script>
