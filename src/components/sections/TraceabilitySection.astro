---
import Container from '../layout/Container.astro';
import MarketingSection from '../ui/MarketingSection.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import { traceability } from '../../content/landing-page';
---
<MarketingSection id="traceability" surface="brand-subtle" spacing="featured">
  <Container variant="content">
    <SectionHeading title={traceability.title} body={traceability.body} align="center" width="narrow" size="lg" />
    <ProductFrame title="Connected traceability" caption="Hubungan risk, control, document, dan evidence tetap dapat dibaca saat implementasi bergerak">
      <div class="traceability-graph">
        <div class="traceability-card">
          <span>Risk</span>
          <strong>Akses tidak sah ke informasi penting</strong>
        </div>
        <div class="traceability-arrow" aria-hidden="true">↓</div>
        <div class="traceability-card">
          <span>Control</span>
          <strong>Pengendalian akses ditetapkan</strong>
        </div>
        <div class="traceability-arrow" aria-hidden="true">↓</div>
        <div class="traceability-card">
          <span>Document</span>
          <strong>Kebijakan dan prosedur akses</strong>
        </div>
        <div class="traceability-arrow" aria-hidden="true">↓</div>
        <div class="traceability-card">
          <span>Evidence</span>
          <strong>Review akses dan bukti penerapan</strong>
        </div>
      </div>
    </ProductFrame>
    <p class="section-supporting-copy section-supporting-copy--center">{traceability.supporting}</p>
  </Container>
</MarketingSection>
