---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  className = '',
} = Astro.props;
const classes = ['button-link', `button-link--${variant}`, `button-link--${size}`, className].filter(Boolean).join(' ');
---
<a class={classes} href={href}>
  <slot />
</a>
